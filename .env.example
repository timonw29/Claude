# Nur noch für die Selbst-Weiterentwicklung (moni/self_dev.py, Claude Agent
# SDK) gebraucht - der Haupt-Chat läuft seit dem Hermes-Umzug nicht mehr
# direkt über die Anthropic-API, siehe HERMES_API_KEY weiter unten.
ANTHROPIC_API_KEY=your-key-here

# Optional overrides (self_dev.py/CLI-Modus, nicht der Hermes-Chat):
# MONI_MODEL=claude-opus-5
# MONI_EFFORT=medium
# MONI_MAX_TOKENS=8192

# Nur für den Web-Modus (moni.web) erforderlich:
MONI_WEB_PASSWORD=change-me

# Hermes-Agent-Bridge (Haupt-Chat) - HERMES_API_KEY muss mit Hermes' eigenem
# API_SERVER_KEY übereinstimmen (~/.hermes/.env auf der Hermes-Seite), siehe
# hermes_skills/README.md für die volle Einrichtung. Hermes läuft mit
# network_mode: host in seinem eigenen Compose-Stack, deshalb "127.0.0.1"
# NICHT verwenden - "host.docker.internal" braucht den extra_hosts-Eintrag
# in docker-compose.yml (schon vorhanden).
HERMES_API_KEY=change-me
HERMES_API_URL=http://host.docker.internal:8642/v1/chat/completions
# Optional: fester Session-Secret, sonst wird bei jedem Start ein neuer erzeugt
# (dann werden bestehende Logins beim Neustart ungültig).
# MONI_SESSION_SECRET=

# Tägliches Börsen-/Portfolio-Briefing (Web-Modus):
# MONI_BRIEFING_TIME=07:00
# MONI_BRIEFING_TIMEZONE=Europe/Berlin

# Sprachausgabe (Web-Modus) - ohne Key bleibt Moni stumm (nur Text):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google-Integration (Gmail & Kalender, Web-Modus) - siehe README für die
# Einrichtung in der Google Cloud Console. Ohne diese drei bleibt Moni bei
# "Kalender nicht verbunden".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://moni.myjarvis-ai.de/oauth/google/callback
