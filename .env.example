ANTHROPIC_API_KEY=your-key-here

# Optional overrides:
# MONI_MODEL=claude-opus-5
# MONI_EFFORT=medium
# MONI_MAX_TOKENS=8192

# Nur für den Web-Modus (moni.web) erforderlich:
MONI_WEB_PASSWORD=change-me
# Optional: fester Session-Secret, sonst wird bei jedem Start ein neuer erzeugt
# (dann werden bestehende Logins beim Neustart ungültig).
# MONI_SESSION_SECRET=

# Tägliches Börsen-/Portfolio-Briefing (Web-Modus):
# MONI_BRIEFING_TIME=07:00
# MONI_BRIEFING_TIMEZONE=Europe/Berlin

# Sprachausgabe (Web-Modus) - ohne Key bleibt Moni stumm (nur Text):
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
