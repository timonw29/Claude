# MT5-Verbindung
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: Pfad zu terminal64.exe, falls MT5 nicht am Standardort liegt
# MT5_PATH=

# "demo" (Standard) oder "live". Auf "live" umstellen setzt zusätzlich
# ALLOW_LIVE_TRADING=true voraus - siehe mt5_connector.py.
MT5_ACCOUNT_TYPE=demo
ALLOW_LIVE_TRADING=false

# Gehandelte Symbole, kommagetrennt
ICT_SYMBOLS=EURUSD,GBPUSD,XAUUSD

# Zeiteinheiten: Bias/Struktur (HTF) und Einstieg (LTF)
ICT_HTF=H4
ICT_LTF=M15

# Risiko
ICT_RISK_PER_TRADE_PCT=0.5
ICT_MAX_DAILY_LOSS_PCT=4.0
ICT_MAX_TOTAL_DRAWDOWN_PCT=9.0
ICT_MAX_OPEN_POSITIONS=3
ICT_MIN_RR=2.0
ICT_MIN_CONFLUENCE=0.7

# Live-Loop
ICT_POLL_SECONDS=60
